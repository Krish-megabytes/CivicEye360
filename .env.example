# ---------------------------------------------------------------------------
# CivicEye 360 — environment configuration
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
# HOST=0.0.0.0 is required for most hosting platforms; 127.0.0.1 is fine for local dev.
HOST=127.0.0.1
PORT=4000
# In production set this to your deployed site origin (e.g. https://your-app.example.com).
CLIENT_ORIGIN=http://localhost:5199

# MongoDB. For local development without a system MongoDB, `npm run dev`
# starts a real MongoDB binary on this URI with data in .data/mongo.
# For production hosting, use a managed MongoDB connection string (e.g. MongoDB Atlas).
MONGODB_URI=mongodb://127.0.0.1:27017/civiceye360

# Auth. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_HOURS=12
# Set true when the app is served over HTTPS (production).
COOKIE_SECURE=false

# OpenAI (optional). Without a key the app uses a clearly labelled
# rules-based fallback for classification and summarisation.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=8000

# Outbound email (optional). Without SMTP settings, email delivery is marked
# "not configured" and password reset exposes a development-only link.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CivicEye 360 <no-reply@civiceye.local>
SMTP_SECURE=false

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Observability / limits
LOG_LEVEL=info
RATE_LIMIT_DISABLED=false

# Client build (Vite). The map uses OpenStreetMap tiles by default; no key
# required. Set VITE_MAP_ENABLED=false to disable map rendering entirely.
VITE_API_URL=
VITE_MAP_ENABLED=true
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
